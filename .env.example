# Séance — Ghost in the Machine
# Copy this file to .env and fill in the values you want to use.
# The séance runs offline with no keys required; sponsors are optional integrations.

# --- Core: local open-weight model (Gemma) ---
# Run Gemma locally via Ollama (ollama.com) and point the séance at it.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
# Alternatively, use Hugging Face Inference API for Gemma:
# HF_TOKEN=hf_...
# HF_MODEL=google/gemma-2-2b-it

# --- Sponsor: Mastra (agent orchestration / memory / tools) ---
# MASTRA_API_KEY=...
# MASTRA_BASE_URL=https://api.mastra.ai

# --- Sponsor: MongoDB Atlas (vector memory for séances) ---
# MONGODB_URI=mongodb+srv://...
# MONGODB_DB=seance
# MONGODB_COLLECTION=seance-memory

# --- Sponsor: Tiger Data / pgvector (hybrid keyword + vector search) ---
# TIGER_DATABASE_URL=postgres://...

# --- Sponsor: Sentry (agent tracing / observability) ---
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=development

# --- Sponsor: SerpApi (live web search for historical language facts) ---
# SERPAPI_KEY=...

# --- Sponsor: ElevenLabs (voice for the séance) ---
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...

# --- Sponsor: Temporal (durable séance sessions) ---
# TEMPORAL_ADDRESS=localhost:7233

# --- Sponsor: Auth0 (sign-in / tool approval for séances) ---
# AUTH0_DOMAIN=...
# AUTH0_CLIENT_ID=...
# AUTH0_AUDIENCE=...

# --- Sponsor: Browserbase (real browser for agents) ---
# BROWSERBASE_API_KEY=...

# --- Sponsor: Backboard (terminal coding agent / model comparison) ---
# BACKBOARD_API_KEY=...

# --- Sponsor: Tinker (fine-tune Gemma for the séance) ---
# TINKER_API_KEY=...

# --- Sponsor: .tech domain (put the séance online) ---
# TECH_DOMAIN=seance.tech

# --- Sponsor: Render / DigitalOcean (hosting) ---
# RENDER_SERVICE_ID=...
# DO_DROPLET_ID=...

# --- Sponsor: TabPFN (tabular predictions over language features) ---
# TABPFN_API_KEY=...

# Séance behavior
SEANCE_LOG_DIR=./séance-logs
SEANCE_SPIRIT=COBOL
SEANCE_CANDLES=3
